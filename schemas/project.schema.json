{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OTWLD/governance/main/schemas/project.schema.json",
  "title": "Governance project",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "trustedActors", "commands", "documents", "merge"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "trustedActors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" } },
    "commands": {
      "type": "object", "additionalProperties": false, "required": ["verify"],
      "properties": {
        "verify": { "type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])(?!.*(?:^| )(?:--fix|--write|--update(?:-?snapshots?|Snapshots?)?|--watch(?:All|-all)?|-u|-w)(?:=| |$))(?:npm (?:test|run (?:test|lint|typecheck|check|validate|build|ci|verify)(?::[A-Za-z0-9_@%+=:,./*?\\[\\]-]+)*)|pnpm (?:test|run (?:test|lint|typecheck|check|validate|build|ci|verify)(?::[A-Za-z0-9_@%+=:,./*?\\[\\]-]+)*)|yarn (?:run )?(?:test|lint|typecheck|check|validate|build|ci|verify)(?::[A-Za-z0-9_@%+=:,./*?\\[\\]-]+)*|bun (?:test|run (?:test|lint|typecheck|check|validate|build|ci|verify)(?::[A-Za-z0-9_@%+=:,./*?\\[\\]-]+)*)|node --(?:test|check)|(?:nx|npx nx|pnpm (?:nx|exec nx)|yarn nx|bunx nx) (?:affected|run-many|test|lint|build))(?: [A-Za-z0-9_@%+=:,./*?\\[\\]-]+)*$" },
        "install": { "type": "string", "minLength": 1, "pattern": "^(?!.*[\\r\\n])(?:npm ci|pnpm install --frozen-lockfile|yarn install --immutable|bun install --frozen-lockfile)(?: [A-Za-z0-9_@%+=:,./*?\\[\\]-]+)*$" }
      }
    },
    "documents": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "purpose"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$" },
          "purpose": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "githubProject": {
      "type": "object", "additionalProperties": false, "required": ["owner", "number", "id", "statusFieldId", "statusOptionIds", "statuses", "priorityFieldId", "priorityOptions", "missingPriority", "includeDrafts", "includeArchived"],
      "properties": {
        "owner": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "number": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "statusFieldId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "statuses": {
          "type": "object", "additionalProperties": false,
          "required": ["ready", "active", "review", "done", "blocked"],
          "properties": {
            "ready": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "active": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "review": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "done": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "blocked": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        },
        "statusOptionIds": {
          "type": "object", "additionalProperties": false,
          "required": ["ready", "active", "review", "done", "blocked"],
          "properties": {
            "ready": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "active": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "review": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "done": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "blocked": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        },
        "priorityField": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "priorityFieldId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "priorityOptions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "$comment": "Options are ordered from highest to lowest priority.",
          "items": { "type": "object", "additionalProperties": false, "required": ["name", "optionId"], "properties": { "name": { "type": "string", "minLength": 1, "pattern": "\\S" }, "optionId": { "type": "string", "minLength": 1, "pattern": "\\S" } } }
        },
        "missingPriority": { "enum": ["first", "last"] },
        "includeDrafts": { "const": false },
        "includeArchived": { "const": false }
      }
    },
    "merge": {
      "type": "object", "additionalProperties": false, "required": ["method", "automatic"],
      "properties": { "method": { "const": "squash" }, "automatic": { "type": "boolean" } }
    }
  }
}
